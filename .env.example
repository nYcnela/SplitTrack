POSTGRES_DB=splittrack
POSTGRES_USER=splittrack
POSTGRES_PASSWORD=splittrack
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Leave empty to disable app password in private network.
APP_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://100.87.218.117:3000
BACKEND_INTERNAL_URL=http://backend:8080
RECEIPT_INSIGHTS_PORT=8000

JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
TZ=Europe/Warsaw
APP_MAX_UPLOAD_SIZE=10MB

# OCR for receipt suggestions
APP_OCR_ENABLED=true
APP_OCR_PROVIDER=tesseract
APP_OCR_COMMAND=tesseract
APP_OCR_LANGUAGE=pol+eng
APP_OCR_PAGE_SEGMENTATION_MODE=6
APP_OCR_TIMEOUT_SECONDS=45
APP_OCR_MAX_ITEMS=40

# Receipt Insights API (the service runs in the same Docker Compose network)
APP_RECEIPT_ANALYZER_BASE_URL=http://receipt-insights:8000
APP_RECEIPT_ANALYZER_ANALYZE_PATH=/receipt/analyze
APP_RECEIPT_ANALYZER_LLM_TYPE=light

# Tabscanner cloud OCR
APP_OCR_TABSCANNER_API_BASE_URL=https://api.tabscanner.com
APP_OCR_TABSCANNER_API_KEY=
APP_OCR_TABSCANNER_REGION=pl
APP_OCR_TABSCANNER_DOCUMENT_TYPE=receipt
APP_OCR_TABSCANNER_DEFAULT_DATE_PARSING=d/m
APP_OCR_TABSCANNER_POLL_DELAY_MILLIS=1000
APP_OCR_TABSCANNER_MAX_POLL_ATTEMPTS=12
